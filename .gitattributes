# Normalize line endings to LF across platforms
* text=auto eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.pt binary
*.onnx binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Windows-only files
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
