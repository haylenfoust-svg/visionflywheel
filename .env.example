# VisionFlywheel environment template — copy to `.env` and fill in
# Secrets MUST come from env (ADR-003), never from the DB.

# ---- Security (REQUIRED in production) ----
VF_SECRET_KEY=please-change-me-to-a-long-random-string
VF_ACCESS_TOKEN_EXPIRE_MINUTES=1440
VF_REQUIRE_PASSWORD_CHANGE=false   # true forces a password change on first login

# ---- Storage ----
VF_DATABASE_URL=sqlite:///./runtime_data/app.db

# ---- Server ----
VF_HOST=127.0.0.1
VF_PORT=8000
VF_RELOAD=0

# ---- CORS ----
VF_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- Email / SMTP (P1.1) ----
# Leave SMTP_HOST empty to use the test transport (writes runtime_data/outbox/*.eml)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_TLS=true
SMTP_SSL=false

# ---- OAuth / SSO (P1.2) ----
# Fill these to enable Google / GitHub login. Empty = provider disabled (501).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
SAML_ENTITY_ID=
SAML_SSO_URL=
SAML_X509_CERT=

# ---- Observability (P1.5) ----
ALERT_EMAIL=
ALERT_WEBHOOK_URL=
LOG_LEVEL=INFO

# ---- Business defaults (optional, override code defaults) ----
# VF_DEFAULT_CONF_THRESHOLD=0.5
# VF_DEFAULT_IOU_THRESHOLD=0.45
# VF_ENABLE_FALLBACK_DETECTOR=true

# ---- LLM (M5) ----
# VF_LLM_MODEL=Qwen/Qwen2.5-0.5B-Instruct
