# VisionFlywheel environment template — copy to `.env` next to docker-compose.yml

# ---- Security (REQUIRED in production) ----
VF_SECRET_KEY=please-change-me-to-a-long-random-string
VF_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---- Build ----
# Set to 1 to bake ultralytics + torch into the image (adds ~2 GB)
WITH_ML=0

# ---- Runtime ----
VF_ENABLE_FALLBACK_DETECTOR=true
