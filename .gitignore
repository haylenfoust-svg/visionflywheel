# ---- VisionFlywheel .gitignore ----

# ===== 运行时产物（机器本地状态，不入库）=====
runtime_data/
!runtime_data/.gitkeep

# ===== 模型权重（大文件，不入库）=====
backend/weights/*.pt
backend/weights/*.onnx
backend/weights/*.engine
!backend/weights/.gitkeep
!backend/weights/README.md

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ===== Node / 前端 =====
node_modules/
dist/
.vite/
.eslintcache
*.local
*.tsbuildinfo
# vue-tsc -b / tsc 误 emit 的构建产物
*.vue.js
vite.config.js
# src 下的 .js 是 tsc 误产物（项目是纯 TS/Vue）；Vite 会优先解析 .js 导致打到过期代码
frontend/src/**/*.js

# ===== 环境与密钥 =====
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# ===== 训练与实验产物 =====
runs/
wandb/
lightning_logs/
mlruns/
*.ckpt
*.pth

# ===== IDE / 编辑器 =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== 日志 =====
*.log
logs/
server.log
server.err
fe.log
fe.err

# ===== 临时文件 =====
*.tmp
*.bak
*.orig
.cache/
